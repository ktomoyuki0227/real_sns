# =====================================
# フロントエンド 本番環境設定
# =====================================
# 使い方: このファイルをコピーして .env.production を作成するか、
#         Vercel ダッシュボードの Environment Variables で直接設定する

# バックエンドのURL (末尾スラッシュなし)
# Render でデプロイした後のURL を入力する
# 例: https://real-sns-backend.onrender.com
REACT_APP_API_URL=https://YOUR_BACKEND_URL_HERE

# バックエンドの画像フォルダURL (末尾スラッシュあり)
# 例: https://real-sns-backend.onrender.com/images/
REACT_APP_PUBLIC_FOLDER=https://YOUR_BACKEND_URL_HERE/images/
